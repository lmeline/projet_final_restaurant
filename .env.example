# Database informations (required)
DB_HOST=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_PORT=

# Credentials for admin account (optional, might be for dev purposes only)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Credentials for client account (optional, might be for dev purposes only)
CLIENT_EMAIL=
CLIENT_PASSWORD=

# JWT secret key, must be generated from somewhere (ex: https://jwtsecretkeygenerator.com)
JWT_SECRET_KEY=